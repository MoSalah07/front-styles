{
  "name": "@design-eg/cli",
  "version": "0.1.0",
  "description": "CLI for design-eg: scaffold the tokens + Tailwind setup and copy components into your project from the registry.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "design-eg": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": [
    "design-system",
    "cli",
    "shadcn",
    "registry",
    "tailwindcss",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/design-eg/design-eg.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "kleur": "^4.1.5",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@design-eg/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/prompts": "^2.4.9",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
