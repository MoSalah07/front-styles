{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "description": "design-eg documentation site and component playground.",
  "scripts": {
    "dev": "next dev",
    "gen:md": "node scripts/gen-md.mjs",
    "build": "node scripts/check-notes-i18n.mjs && node scripts/gen-md.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"const r=(p)=>require('fs').rmSync(p,{recursive:true,force:true});r('.next');r('public/docs');r('public/docs.md')\"",
    "lint:notes": "node scripts/check-notes-i18n.mjs",
    "fonts:og": "node scripts/fetch-og-fonts.mjs"
  },
  "dependencies": {
    "@design-eg/tokens": "workspace:*",
    "@design-eg/ui": "workspace:*",
    "@hookform/resolvers": "^5.9.1",
    "cmdk": "^1.1.1",
    "input-otp": "^1.5.0",
    "lucide-react": "catalog:",
    "next": "^16.3.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "^7.88.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@design-eg/registry": "workspace:*",
    "@design-eg/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  }
}
