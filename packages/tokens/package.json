{
  "name": "@design-eg/tokens",
  "version": "0.2.0",
  "description": "Design tokens for design-eg: brand seeds compiled into a 3-tier CSS variable system (primitives → semantic → component) with light/dark modes, multi-brand theming and WCAG contrast checks at build time.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "brands",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": "./dist/index.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./tokens.json": "./dist/tokens.json",
    "./brands/*": "./brands/*.brand.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": [
    "design-tokens",
    "design-system",
    "css-variables",
    "tailwindcss",
    "theming",
    "dark-mode",
    "rtl",
    "oklch"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/design-eg/design-eg.git",
    "directory": "packages/tokens"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@design-eg/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "culori": "^4.0.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
