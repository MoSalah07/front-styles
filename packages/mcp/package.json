{
  "name": "@design-eg/mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for the design-eg catalogue: lets an AI assistant query components, blocks, templates and design tokens instead of guessing from training data.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "design-eg-mcp": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/snapshot-registry.mjs && tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "design-system",
    "registry",
    "react",
    "shadcn"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/design-eg/design-eg.git",
    "directory": "packages/mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@design-eg/registry": "workspace:*",
    "@design-eg/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
