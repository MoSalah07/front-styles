{
  "name": "@design-eg/ui",
  "version": "0.2.0",
  "description": "React 19 components for design-eg: accessible Radix primitives styled with Tailwind v4 and design tokens. RTL-first, dark-mode native, tree-shakeable.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./cn": {
      "types": "./dist/lib/cn.d.ts",
      "import": "./dist/lib/cn.js"
    },
    "./*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/gen-barrel.mjs && tsdown && node scripts/copy-styles.mjs",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "barrel": "node scripts/gen-barrel.mjs"
  },
  "keywords": [
    "react",
    "components",
    "design-system",
    "tailwindcss",
    "radix-ui",
    "rtl",
    "dark-mode",
    "accessible",
    "shadcn"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/design-eg/design-eg.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@hookform/resolvers": ">=5",
    "cmdk": ">=1",
    "input-otp": ">=1.4",
    "react": ">=19",
    "react-dom": ">=19",
    "react-hook-form": ">=7.60",
    "recharts": ">=3",
    "sonner": ">=2",
    "tailwindcss": ">=4",
    "zod": ">=4"
  },
  "peerDependenciesMeta": {
    "@hookform/resolvers": {
      "optional": true
    },
    "cmdk": {
      "optional": true
    },
    "input-otp": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    },
    "recharts": {
      "optional": true
    },
    "sonner": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "@design-eg/tokens": "workspace:^",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "lucide-react": "catalog:",
    "radix-ui": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@design-eg/typescript-config": "workspace:*",
    "@hookform/resolvers": "^5.9.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.12.0",
    "cmdk": "^1.1.1",
    "input-otp": "^1.5.0",
    "jsdom": "^30.1.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "^7.88.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "^4.6.5"
  }
}
